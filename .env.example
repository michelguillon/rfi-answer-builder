# Copy this file to .env and fill in your key:
#   cp .env.example .env   (PowerShell: Copy-Item .env.example .env)
# .env is git-ignored — never commit your real key.
MISTRAL_API_KEY=your-mistral-api-key-here

# ChromaDB idle eviction (seconds). The API layer lazy-loads ChromaDB on
# first request and releases it after this many seconds of inactivity,
# so an idle backend drops from ~1.2GB to ~50MB. 0 = load once on first
# request, never evict (the cleanup thread does not start).
CHROMA_IDLE_TTL_SECONDS=300
