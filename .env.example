# Copy this file to .env and fill in your key:
#   cp .env.example .env   (PowerShell: Copy-Item .env.example .env)
# .env is git-ignored — never commit your real key.
MISTRAL_API_KEY=your-mistral-api-key-here

# ChromaDB idle eviction (seconds). The API layer lazy-loads ChromaDB on
# first request and releases it after this many seconds of inactivity,
# reclaiming the variable part of the footprint (active ~1.2GB on the real
# corpus -> idle ~500MB). The ~500MB floor is torch + the cross-encoder
# reranker, loaded on the first answer and resident for the process life;
# eviction does not reclaim that. 0 = load once, never evict (no thread).
CHROMA_IDLE_TTL_SECONDS=300
